<?xml version="1.0" encoding="utf-8"?>
<!--
  Both widgets. The content is drawn in Widget.java as white images; each image is tinted with a colour
  resource here, so light and dark mode follow the phone.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="4dp"
        android:background="@drawable/widget_bg">

        <ImageView
            android:id="@+id/w_mid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:tint="@color/mid" />

        <ImageView
            android:id="@+id/w_red"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:tint="@color/red" />

        <ImageView
            android:id="@+id/w_fg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:tint="@color/fg" />
    </FrameLayout>

</FrameLayout>
